APP_NAME="mini-rag"
APP_VERSION="0.1"

FILE_ALLOWED_EXTENSTION=["text/plain", "application/pdf"]
FILE_MAX_SIZE=10

FILE_DEFAULT_CHUNK_SIZE=512000

####################### DB CONFIG ########################
MONGODB_URL=""
MONGODB_DATABASE=""

POSTGRES_USERNAME=""
POSTGRES_PASSWORD=""
POSTGRES_HOST=""
POSTGRES_PORT=
POSTGRES_MAIN_DATABASE=""

####################### LLM CONFIG ########################
GENERATION_BACKEND_LITERAL=["OPENAI", "COHERE"]
GENERATION_BACKEND="OPENAI"

EMBEDDING_BACKEND_LITERAL=["OPENAI", "COHERE"]
EMBEDDING_BACKEND="COHERE"

OPENAI_API_KEY=""
OPENAI_API_URL=""
COHERE_API_KEY=""
HF_ACCESS_TOKEN=""

GENERATION_MODEL_ID_LITERAL=["gemma2:9b-instruct-q5_0", "deepseek-ai/DeepSeek-V3-0324", "openai/gpt-oss-120b:cerebras", "command-a-03-2025", "gpt-3.5-turbo-0125"]
GENERATION_MODEL_ID="gpt-3.5-turbo-0125"

EMBEDDING_MODEL_ID_LITERAL=["embed-multilingual-light-v3.0"]
EMBEDDING_MODEL_ID="embed-multilingual-light-v3.0"
EMBEDDING_MODEL_SIZE=384

DEFAULT_INPUT_MAX_CHARACTER=1024
DEFAULT_GENERATION_MAX_TOKENS=200
DEFAULT_GENERATION_TEMPERATURE=0.1

####################### Vector DB CONFIG ########################
VECTOR_DB_BACKEND_LITERAL=["QDRANT", "PGVECTOR"]
VECTOR_DB_BACKEND="PGVECTOR"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="cosine"
VECTOR_DB_PGVEC_INDEX_THRESHOLD=300


####################### TEMPLATES CONFIG ########################
PRIMARY_LANGUAGE="en"
DEFAULT_LANGUAGE="en"

####################### CELERY TASK QUEUE CONFIG ########################
CELERY_BROKER_URL="amqp://minirag_user:minirag_rabbitmq_2222@localhost:5672/minirag_vhost"
CELERY_RESULT_BACKEND="redis://:minirag_redis_2222@localhost:6379/0"
CELERY_TASK_SERIALIZER="json"
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_ACKS_LATE=false
CELERY_WORKER_CONCURRENCY=2